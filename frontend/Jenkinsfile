pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Install dependencies') {
      steps {
        sh 'cd frontend && npm ci'
      }
    }

    stage('Build') {
      steps {
        sh 'cd frontend && npm run build'
      }
    }

    stage('Deploy to webroot') {
      steps {
        sh '''
          rm -rf /var/www/frontend/* || true
          rsync -av --delete frontend/dist/ /var/www/frontend/
        '''
      }
    }
  }

  post {
    success { echo "Deployed successfully!" }
  }
}
